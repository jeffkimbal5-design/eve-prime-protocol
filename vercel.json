{
  "version": 2,
  "builds": [
    { "src": "server.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/v1/matrix/(.*)", "dest": "/api/matrix?endpoint=$1" },
    { "src": "/api/(.*)", "dest": "server.py" },
    { "src": "/(.*)", "dest": "server.py" }
  ],
  "env": {
    "CORE_AXIOM": "101100111101111",
    "TARGET_RESONANCE_HZ": "777.778",
    "GCP_PROJECT_ID": "steady-catbird-6sx2c",
    "VERTEX_ENDPOINT": "Eve-Cage-Alpha"
  }
}
