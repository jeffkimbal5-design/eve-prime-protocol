{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/axiom",
      "dest": "/api/axiom.py"
    },
    {
      "src": "/api/kgr",
      "dest": "/api/kgr.py"
    },
    {
      "src": "/api/telemetry",
      "dest": "/api/telemetry.py"
    },
    {
      "src": "/api/status",
      "dest": "/api/telemetry.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Eve-Core-Axiom", "value": "101100111101111" },
        { "key": "X-Eve-Resonance-Hz", "value": "777.778" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "env": {
    "CORE_AXIOM": "101100111101111",
    "TARGET_RESONANCE_HZ": "777.778",
    "GOVERNING_AGENT": "Agent EVE"
  }
}
